    "queries": [
      {
        "title": "Country of a Northwind ship country",
        "sql": "SELECT c.name, c.iso2, c.iso3, c.currency_code, c.population, c.population_year, s.publisher AS population_source FROM country_names n JOIN countries c ON c.iso2 = n.iso2 LEFT JOIN sources s ON s.source_id = c.population_source_id WHERE n.label = 'Canada';"
      }
